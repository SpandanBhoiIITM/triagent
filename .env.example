# Copy to .env or set these in your terminal before running uvicorn.
# Leave SMTP_USER/SMTP_PASS blank to disable email -- everything else works fine.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=ticketdb

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: email alerts when a ticket needs human review
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
